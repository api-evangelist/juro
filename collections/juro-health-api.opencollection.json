{
  "opencollection": "1.0.0",
  "info": {
    "name": "Juro Contracts Health API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check API status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.juro.com/v3/health"
          },
          "docs": "Returns the API status and confirms the supplied API key is valid."
        }
      ]
    }
  ],
  "bundled": true
}